# ==============================================================================
# BookLeaf Assignment 2: Bubble.io & n8n Integration (.env.example)
# ==============================================================================

# Bubble App Configuration
BUBBLE_APP_NAME=bookleaf-portal
BUBBLE_API_TOKEN=your_bubble_data_api_token_here
BUBBLE_BASE_URL=https://bookleaf-portal.bubbleapps.io/version-test/api/1.1

# n8n Automation Engine Webhook Configuration
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/royalty-summary
N8N_WEBHOOK_SECRET=bookleaf-n8n-secret-key-2026

# Local Mock Test Harness Ports
MOCK_BUBBLE_PORT=3001
MOCK_LLM_PORT=3002

# Optional LLM API Key (for live AI calls in n8n or direct tests)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here